{
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "ask",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "curl *": "deny",
      "npm run build": "allow",
      "poe types": "allow",
      "poe lint": "allow",
      "poe format *": "allow",
      "poe test": "allow"
    },
    "external_directory": "ask"
  }
}
